# Reactive server configuration. Copy to .env (never commit .env). Every provider key is optional:
# without keys the server answers every ask from rules (instant answers, no AI upgrades).

# --- server
PORT=8790
HOST=0.0.0.0
# Comma-separated manifest files (one game each). Default: ./liveforge.yaml, else examples/*.liveforge.yaml
LIVEFORGE_MANIFESTS=examples/livecraft.liveforge.yaml,examples/counterforge.liveforge.yaml,examples/godot-village.liveforge.yaml
LIVEFORGE_DB=data/liveforge.sqlite
LIVEFORGE_DATA_DIR=data
LIVEFORGE_LOG_LEVEL=info
LIVEFORGE_CORS_ORIGINS=*
# Requests per minute per client (publishable key + client IP)
LIVEFORGE_RATE_LIMIT_PER_MIN=600
# Behind a reverse proxy (Render, Fly, nginx): take the client IP from X-Forwarded-For
# LIVEFORGE_TRUST_PROXY=0
# Serve a built web game at / (after the API, admin and dashboard routes), e.g. the Livecraft demo:
# LIVEFORGE_STATIC_DIR=examples/livecraft/dist

# --- auth
# Publishable SDK keys per game: game=key1|key2,othergame=key3
LIVEFORGE_SDK_KEYS=
# Admin key (dashboard + /admin/*)
LIVEFORGE_ADMIN_KEY=
# Dev mode (default on unless NODE_ENV=production): with no keys set, accepts pk_dev_<gameId> and dev-admin
LIVEFORGE_DEV=1

# --- LLM (Claude)
ANTHROPIC_API_KEY=
# LIVEFORGE_LLM_PROVIDER=claude        # or none
# LIVEFORGE_MODEL_FAST=claude-haiku-4-5
# LIVEFORGE_MODEL_RICH=claude-sonnet-5-5
# LIVEFORGE_LLM_TIMEOUT_MS=8000
# LIVEFORGE_LLM_STRUCTURED_MODE=output_config   # or strict_tool
# LIVEFORGE_LLM_EFFORT=low
# LIVEFORGE_REFUSAL_FALLBACK=1
# LIVEFORGE_PRICES={"claude-haiku-4-5":[1,5]}
# Record/replay LLM cassettes (docs/record-replay.md): live | record | replay
# LIVEFORGE_PROVIDER_MODE=live
# LIVEFORGE_CASSETTES=./cassettes

# --- speech-to-text (openai | whispercpp | none; auto-detected from the keys below)
# LIVEFORGE_STT=openai
OPENAI_API_KEY=
# OPENAI_STT_MODEL=whisper-1
# OPENAI_BASE_URL=https://api.openai.com/v1
# WHISPER_CPP_BIN=/path/to/whisper-cli
# WHISPER_CPP_MODEL=/path/to/ggml-base.en.bin
# WHISPER_CPP_THREADS=4
# FFMPEG_BIN=ffmpeg
# STT spend caps (Whisper is billed per call, outside the manifest's LLM budgets). 0 = no limit.
# LIVEFORGE_STT_PER_MIN=6          # per client
# LIVEFORGE_STT_PER_DAY=0          # per game (in memory)
# LIVEFORGE_STT_MAX_BYTES=10485760

# --- 3D (Hyper3D Rodin; also needs manifest clamps.forge.meshJobs: true)
HYPER3D_API_KEY=
# HYPER3D_BASE_URL=https://api.hyper3d.com/api/v2
# HYPER3D_POLL_MS=5000
