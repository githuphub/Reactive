{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "bad_request",
            "unauthorized",
            "forbidden",
            "not_found",
            "rate_limited",
            "budget_exceeded",
            "moderated",
            "invalid_manifest",
            "unknown_kind",
            "module_disabled",
            "provider_unavailable",
            "provider_error",
            "timeout",
            "internal"
          ]
        },
        "message": {
          "type": "string"
        },
        "details": {}
      },
      "required": [
        "code",
        "message"
      ]
    }
  },
  "required": [
    "error"
  ],
  "$id": "https://liveforge.dev/schema/v1/ErrorBody.json",
  "title": "ErrorBody"
}
