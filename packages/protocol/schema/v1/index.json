  "commonRecipeParams": {
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "false switches the recipe off without removing the line."
    },
    "cooldownSec": {
      "type": "number",
      "description": "Seconds before the same speaker reacts with this recipe again (per player). Each recipe has its own default."
    },
    "chance": {
      "type": "number",
      "default": 1,
      "description": "0-1 probability that a reaction fires when its conditions hold (seeded, so replays match)."
    },
    "when": {
      "type": "string",
      "description": "Extra trait-rule DSL gate, e.g. \"stat(zone) == \\\"courtyard\\\"\". The recipe only fires while it is true."
