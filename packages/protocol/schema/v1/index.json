    "speakers": {
      "type": "string[]",
      "description": "Persona ids allowed to voice this recipe (default: personas in the player's zone, else any)."
    },
    "ai": {
      "type": "boolean",
      "default": true,
      "description": "Let the LLM write fresh variants for this recipe in the background (keyed servers only)."
    }
