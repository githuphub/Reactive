{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "npc": {
      "type": "string"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "history": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "player",
              "npc"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "role",
          "text"
        ]
      }
    },
    "stream": {
      "type": "boolean"
    },
    "context": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "npc",
    "text"
  ],
  "$id": "https://liveforge.dev/schema/v1/ask.npc.reply.params.json",
  "title": "ask.npc.reply.params"
}
