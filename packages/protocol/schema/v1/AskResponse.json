{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_\\-.:]+$"
    },
    "kind": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "instant",
        "upgrade"
      ]
    },
    "result": {},
    "source": {
      "type": "string",
      "enum": [
        "rules",
        "cache",
        "ai",
        "bake"
      ]
    },
    "why": {
      "type": "string",
      "maxLength": 300
    },
    "upgrade": {
      "type": "string",
      "enum": [
        "pending",
        "none"
      ]
    },
    "ms": {
      "type": "number"
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "kind",
    "stage",
    "result",
    "source",
    "ts"
  ],
  "$id": "https://liveforge.dev/schema/v1/AskResponse.json",
  "title": "AskResponse"
}
