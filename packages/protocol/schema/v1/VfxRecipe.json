                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "t",
                "color"
              ]
            }
          },
          "blend": {
            "default": "additive",
            "type": "string",
            "enum": [
              "additive",
              "alpha"
            ]
          },
          "attach": {
            "type": "string"
          }
        },
        "required": [
          "width",
          "lifetime",
          "colorRamp"
        ]
      }
    },
    "auras": {
      "maxItems": 3,
      "type": "array",
