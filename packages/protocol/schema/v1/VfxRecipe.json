{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "maxLength": 64
    },
    "duration": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "attach": {
      "type": "string",
      "maxLength": 32
    },
    "emitters": {
      "default": [],
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shape": {
            "type": "string",
            "enum": [
              "point",
              "sphere",
              "box",
              "cone",
              "ring",
              "line"
            ]
          },
          "radius": {
            "type": "number",
            "minimum": 0
          },
          "extents": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          },
          "angle": {
            "type": "number",
            "minimum": 0,
            "maximum": 180
          },
          "rate": {
            "type": "number",
            "minimum": 0
          },
          "burst": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maxParticles": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "lifetime": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "number",
                "minimum": 0
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "velocity": {
            "type": "object",
            "properties": {
              "dir": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 3,
                "maxItems": 3
              },
              "speed": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "spread": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
