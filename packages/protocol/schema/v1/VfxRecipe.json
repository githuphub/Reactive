              "sphere",
              "ring",
              "column",
              "ground_decal"
            ]
          },
          "radius": {
            "type": "number",
            "minimum": 0
          },
          "height": {
            "type": "number",
            "minimum": 0
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "intensity": {
            "type": "number",
            "minimum": 0,
            "maximum": 3
          },
          "pulse": {
            "type": "object",
            "properties": {
              "speed": {
                "type": "number",
                "minimum": 0
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
