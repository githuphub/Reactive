{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "taunt": {
      "type": "string",
      "maxLength": 90
    },
    "shape": {
      "type": "string",
      "enum": [
        "slam",
        "beam",
        "projectile",
        "ring",
        "spikes",
        "meteor",
        "grab",
        "summon"
      ]
    },
    "element": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    },
    "pattern": {
      "type": "string",
      "enum": [
        "single",
        "fan",
        "line",
        "spiral",
        "burst",
        "ring"
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "telegraph": {
      "type": "number"
    },
    "speed": {
      "type": "number"
    },
    "size": {
      "type": "number"
    },
    "damage_budget": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "none",
        "burning",
        "chilled",
        "charged",
        "wet",
        "oiled",
        "poisoned",
        "slowed"
      ]
    },
    "bias": {
      "type": "string",
      "enum": [
        "none",
        "left",
        "right"
      ]
    },
    "engine": {
      "type": "object",
      "properties": {
        "moveId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "params": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          }
        }
      },
      "required": [
        "moveId"
      ]
    }
  },
  "required": [
    "name",
    "taunt",
    "shape",
    "element",
    "pattern",
    "count",
    "telegraph",
    "speed",
    "size",
    "damage_budget",
    "status",
    "bias"
  ],
  "$id": "https://liveforge.dev/schema/v1/MoveSpec.json",
  "title": "MoveSpec"
}
