{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "t": {
          "type": "string",
          "const": "subscribe"
        },
        "world": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_\\-.:]+$"
        },
        "player": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_\\-.:]+$"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "directives",
              "upgrades",
              "chunks",
              "events",
              "jobs"
            ]
          }
        }
      },
      "required": [
        "t",
        "world"
      ]
    },
    {
      "type": "object",
      "properties": {
        "t": {
          "type": "string",
          "const": "unsubscribe"
        },
        "world": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_\\-.:]+$"
        },
        "player": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_\\-.:]+$"
        }
      },
      "required": [
        "t",
        "world"
      ]
    },
    {
      "type": "object",
      "properties": {
        "t": {
          "type": "string",
          "const": "ping"
        },
        "ts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "t"
      ]
    }
  ],
  "$id": "https://liveforge.dev/schema/v1/WsClientMessage.json",
  "title": "WsClientMessage"
}
