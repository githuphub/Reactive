{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "aggression": {
      "default": 0.5,
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "difficultyMode": {
      "default": "hidden",
      "type": "string",
      "enum": [
        "hidden",
        "assist",
        "off"
      ]
    },
    "tension": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "ts",
          "value"
        ]
      }
    },
    "bosses": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "phase": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "invented": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "taunt": {
                  "type": "string",
                  "maxLength": 90
                },
                "shape": {
                  "type": "string",
                  "enum": [
                    "slam",
                    "beam",
                    "projectile",
                    "ring",
                    "spikes",
                    "meteor",
                    "grab",
                    "summon"
                  ]
                },
                "element": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                },
                "pattern": {
                  "type": "string",
                  "enum": [
                    "single",
                    "fan",
                    "line",
                    "spiral",
                    "burst",
                    "ring"
                  ]
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8
                },
                "telegraph": {
                  "type": "number"
                },
                "speed": {
                  "type": "number"
                },
                "size": {
                  "type": "number"
                },
                "damage_budget": {
                  "type": "number"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "none",
                    "burning",
                    "chilled",
                    "charged",
                    "wet",
                    "oiled",
                    "poisoned",
                    "slowed"
                  ]
                },
                "bias": {
                  "type": "string",
                  "enum": [
                    "none",
                    "left",
                    "right"
                  ]
                },
                "engine": {
                  "type": "object",
                  "properties": {
                    "moveId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "params": {
                      "default": {},
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": [
                          "number",
                          "string",
                          "boolean"
                        ]
                      }
                    }
                  },
                  "required": [
                    "moveId"
                  ]
                }
              },
              "required": [
                "name",
                "taunt",
                "shape",
                "element",
                "pattern",
                "count",
                "telegraph",
                "speed",
                "size",
                "damage_budget",
                "status",
                "bias"
              ]
            }
          },
          "attune": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "phase",
          "invented",
          "attune"
        ]
      }
    },
    "timeline": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string"
          },
          "summary": {
            "type": "string",
            "maxLength": 200
          },
          "why": {
            "type": "string",
            "maxLength": 300
          },
          "source": {
            "type": "string",
            "enum": [
              "rules",
              "cache",
              "ai",
              "bake"
            ]
          },
          "data": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "ts",
          "kind",
          "summary",
          "why",
          "source"
        ]
      }
    }
  },
  "$id": "https://liveforge.dev/schema/v1/Projection_director.state.json",
  "title": "Projection_director.state"
}
