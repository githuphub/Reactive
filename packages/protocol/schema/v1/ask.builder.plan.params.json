{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "site": {
      "type": "object",
      "properties": {
        "size": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "ground": {
          "type": "string",
          "maxLength": 48
        }
      },
      "required": [
        "size"
      ]
    },
    "palette": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 48
      }
    },
    "style": {
      "type": "string",
      "maxLength": 200
    },
    "npc": {
      "type": "string",
      "maxLength": 64
    },
    "context": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "prompt",
    "site"
  ],
  "$id": "https://liveforge.dev/schema/v1/ask.builder.plan.params.json",
  "title": "ask.builder.plan.params"
}
