{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "spawner": {
      "type": "string",
      "maxLength": 64
    },
    "zone": {
      "type": "string",
      "maxLength": 64
    },
    "position": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "units": {
      "minItems": 1,
      "type": "array",
