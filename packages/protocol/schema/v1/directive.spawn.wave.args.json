        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "maxLength": 64
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "elite": {
            "type": "boolean"
          },
          "modifiers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tactic": {
            "type": "string",
            "maxLength": 32
          }
        },
        "required": [
          "type",
          "count"
        ]
      }
    }
  },
  "required": [
    "units"
  ],
  "$id": "https://liveforge.dev/schema/v1/directive.spawn.wave.args.json",
  "title": "directive.spawn.wave.args"
}
