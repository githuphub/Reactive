{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_\\-.:]+$"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "args": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "why": {
      "type": "string",
      "maxLength": 200
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "world": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_\\-.:]+$"
    },
    "player": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_\\-.:]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "string",
      "maxLength": 32
    }
  },
  "required": [
    "id",
    "kind",
    "target",
    "args",
    "why",
    "ts",
    "world",
    "player"
  ],
  "$id": "https://liveforge.dev/schema/v1/Directive.json",
  "title": "Directive"
}
