{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "npcs": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "npc": {
            "type": "string"
          },
          "player": {
            "type": "string"
          },
          "attitude": {
            "default": 0,
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "entries": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "maxLength": 300
                },
                "salience": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "ts": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "kind": {
                  "default": "other",
                  "type": "string",
                  "enum": [
                    "conversation",
                    "witnessed",
                    "rumour",
                    "gift",
                    "harm",
                    "trade",
                    "other"
                  ]
                },
                "ref": {
                  "type": "string",
                  "maxLength": 64
                }
              },
              "required": [
                "text",
                "salience",
                "ts"
              ]
            }
          },
          "summary": {
            "default": "",
            "type": "string"
          },
          "lastTalked": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "npc",
          "player"
        ]
      }
    }
  },
  "$id": "https://liveforge.dev/schema/v1/Projection_persona.memories.json",
  "title": "Projection_persona.memories"
}
